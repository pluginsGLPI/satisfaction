{{ hidden_survey_id|raw }}
<div{% if preview %} class="spaced" id="tabsbody"{% endif %}>
   <table class="tab_cadre_fixe">
      <tbody>
         {% for question in questions %}
            <tr>
               <td class="w-50">{{ question.name|nl2br }}</td>
               <td>{{ question.answer|raw }}</td>
            </tr>
         {% endfor %}
      </tbody>
   </table>
</div>
{{ table_script|raw }}
