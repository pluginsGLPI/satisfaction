<form name="form" method="post" action="{{ item_form_url }}">
   <div class="center">
      <table class="tab_cadre_fixe">
         <tr>
            <th colspan="4">{{ __('Add a question', 'satisfaction') }}</th>
         </tr>
         <tr class="tab_bg_1">
            <td>{{ type_name }}&nbsp;:</td>
            <td>
               <textarea name="name" cols="50" rows="4"
                         class="form-control">{{ name_value }}</textarea>
               <input type="hidden" name="{{ items_id_field }}" value="{{ items_id_value }}">
            </td>
            <td rowspan="2">{{ __('Comments') }}</td>
            <td rowspan="2">
               <textarea name="comment" cols="60" rows="6"
                         class="form-control">{{ comment_value }}</textarea>
            </td>
         </tr>
         <tr class="tab_bg_1">
            <td>{{ __('Type') }}</td>
            <td>{{ type_dropdown|raw }}{{ type_script|raw }}</td>
         </tr>
         <tr class="tab_bg_1" id="show_note"{% if not show_note %} style="display: none"{% endif %}>
            <td>{{ __('Note on', 'satisfaction') }}</td>
            <td>{{ number_dropdown|raw }}</td>
            <td>{{ __('Default value') }}</td>
            <td id="default_value">{{ default_value_dropdown|raw }}</td>
         </tr>
         <tr>
            <td class="tab_bg_2 center" colspan="4">
               <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
               {% if is_new %}
                  <input type="hidden" name="{{ items_id_field }}" value="{{ parent_id }}">
                  <button type="submit" name="add" class="btn btn-primary">{{ _x('button', 'Add') }}</button>
               {% else %}
                  <input type="hidden" name="id" value="{{ item_id }}">
                  <button type="submit" name="update" class="btn btn-primary">{{ _x('button', 'Save') }}</button>
               {% endif %}
            </td>
         </tr>
      </table>
   </div>
</form>
