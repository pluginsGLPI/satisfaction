<tr class="tab_bg_1">
   <td>{{ __('Name') }}</td>
   <td>
      <input type="text" name="name" value="{{ item.fields.name }}" size="40"
             class="form-control">
   </td>
   <td>{{ __('Comments') }}</td>
   <td>
      <textarea name="comment" cols="60" rows="6"
                class="form-control">{{ item.fields.comment }}</textarea>
   </td>
</tr>

<tr class="tab_bg_1">
   <td>{{ __('Active') }}</td>
   <td>{{ yesno_active|raw }}</td>
   <td colspan="2"></td>
</tr>
